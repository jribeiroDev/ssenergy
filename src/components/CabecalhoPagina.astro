---
// Cabeçalho das páginas interiores: H1 + subtítulo.
interface Props {
  titulo: string;
  subtitulo?: string;
  eyebrow?: string;
}

const { titulo, subtitulo, eyebrow } = Astro.props;
---

<section class="relative overflow-hidden bg-navy-900 text-white">
  <div class="pointer-events-none absolute -top-24 -right-24 size-96 rounded-full bg-laranja-500/10 blur-3xl"></div>
  <div class="container-site relative py-12 sm:py-16">
    {eyebrow && <p class="text-xs font-semibold tracking-widest text-laranja-400 uppercase">{eyebrow}</p>}
    <h1 class="mt-2 max-w-4xl text-3xl text-white sm:text-5xl">{titulo}</h1>
    {subtitulo && <p class="mt-4 max-w-3xl text-lg text-white/80">{subtitulo}</p>}
    <slot />
  </div>
</section>
