---
// Perguntas frequentes com <details> (sem JS). O JSON-LD FAQPage é gerado pela página.
interface Props {
  itens: { pergunta: string; resposta: string }[];
  titulo?: string;
}

const { itens, titulo = 'Perguntas frequentes' } = Astro.props;
---

{
  itens.length > 0 && (
    <section class="bg-cinza-50 py-16 sm:py-20" aria-labelledby="faq-titulo">
      <div class="container-site max-w-4xl">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-titulo" class="titulo-secao">{titulo}</h2>
        <div class="mt-8 divide-y divide-cinza-100 rounded-2xl bg-white ring-1 ring-cinza-100">
          {itens.map((f) => (
            <details class="group p-5 sm:p-6">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-navy-950 [&::-webkit-details-marker]:hidden">
                {f.pergunta}
                <span class="mt-1 text-laranja-700 transition-transform group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="mt-3 leading-relaxed text-cinza-600">{f.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
