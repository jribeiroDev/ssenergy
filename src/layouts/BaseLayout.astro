---
import { Font } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactoFlutuante from '../components/ContactoFlutuante.astro';
import { breadcrumbs as breadcrumbsLd, grafo, negocioLocal, website } from '../lib/schema';

interface Props {
  titulo: string;
  descricao: string;
  imagem?: ImageMetadata;
  imagemAlt?: string;
  tipo?: 'website' | 'article';
  noindex?: boolean;
  publicado?: Date;
  atualizado?: Date;
  /** Trilho de navegação (sem a página inicial) — gera BreadcrumbList */
  trilho?: { nome: string; url: string }[];
  /** Nós JSON-LD adicionais específicos da página */
  schema?: object[];
}

const { trilho, schema = [], ...seo } = Astro.props;
const jsonLd = grafo(
  negocioLocal(),
  website(),
  ...(trilho?.length ? [breadcrumbsLd([{ nome: 'Início', url: '/' }, ...trilho])] : []),
  ...schema,
);
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#091326" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog SS Energy" href="/rss.xml" />
    <Font cssVariable="--font-poppins" preload />
    <Seo {...seo} jsonLd={jsonLd} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main id="conteudo" class="flex-1">
      <slot />
    </main>
    <Footer />
    <ContactoFlutuante />
    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </body>
</html>
