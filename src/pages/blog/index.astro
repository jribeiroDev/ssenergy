---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CabecalhoPagina from '../../components/CabecalhoPagina.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { artigosPublicados } from '../../lib/conteudo';
import { formatarData } from '../../lib/site';

const artigos = await artigosPublicados();
const trilho = [{ nome: 'Blog', url: '/blog/' }];
---

<BaseLayout
  titulo="Blog — energia solar e mobilidade elétrica"
  descricao="Guias e novidades sobre painéis solares, baterias, carregadores para carros elétricos e eficiência energética."
  trilho={trilho}
  noindex={artigos.length === 0}
>
  <CabecalhoPagina titulo="Blog" subtitulo="Guias práticos sobre energia solar, mobilidade elétrica e eficiência energética." trilho={trilho} />
  <section class="py-16">
    <div class="container-site">
      {
        artigos.length === 0 ? (
          <p class="text-center text-cinza-600">Brevemente: artigos e guias da equipa SS Energy.</p>
        ) : (
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {artigos.map((a) => (
              <article class="group relative flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-cinza-100 hover:shadow-lg">
                {a.data.capa && (
                  <Image src={a.data.capa} alt={a.data.capaAlt ?? ''} widths={[400, 640]} sizes="(min-width: 1024px) 380px, 100vw" class="aspect-[16/9] w-full object-cover" />
                )}
                <div class="flex flex-1 flex-col p-6">
                  <time datetime={a.data.data.toISOString()} class="text-xs text-cinza-600">
                    {formatarData(a.data.data)}
                    {a.data.rascunho && <span class="ml-2 rounded bg-laranja-500/20 px-1.5 py-0.5 text-laranja-700">rascunho</span>}
                  </time>
                  <h2 class="mt-2 text-lg leading-snug">
                    <a href={`/blog/${a.id}/`} class="after:absolute after:inset-0">{a.data.titulo}</a>
                  </h2>
                  <p class="mt-2 flex-1 text-sm text-cinza-600">{a.data.resumo}</p>
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
  <CtaBanner />
</BaseLayout>
